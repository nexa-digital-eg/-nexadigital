# Nexa Digital — environment variables

# --- Contact form leads (Neon Postgres) ---
# Neon connection string. The contact form falls back to WhatsApp without it.
# Vercel → project → Storage → Neon → ".env.local" tab, or Neon dashboard (pooled string).
DATABASE_URL=

# --- AI Assistant (Groq) ---
# Groq API key — get one free at https://console.groq.com/keys (no card required).
# Without it, the chat widget tells visitors to use WhatsApp instead.
GROQ_API_KEY=

# Optional: model to use. Defaults to allam-2-7b (built for Arabic, clean output).
# Strong multilingual alternative: qwen/qwen3-32b
GROQ_MODEL=allam-2-7b
