# Nexa Digital — environment variables

# --- Contact form leads (Neon Postgres) ---
# Neon connection string. The contact form falls back to WhatsApp without it.
# Vercel → project → Storage → Neon → ".env.local" tab, or Neon dashboard (pooled string).
DATABASE_URL=

# --- AI Assistant (Gemini) ---
# Google AI Studio API key — get one free at https://aistudio.google.com/apikey
# Without it, the chat widget tells visitors to use WhatsApp instead.
GOOGLE_AI_API_KEY=

# Optional: Gemini model to use. Defaults to gemini-2.0-flash (fast + free tier).
# Other options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
